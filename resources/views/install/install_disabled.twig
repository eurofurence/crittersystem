<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Installation Disabled - Critter System</title>
    <link href="/assets/special/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/special/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <div class="mb-4">
                            <i class="bi bi-gear text-secondary" style="font-size: 4rem;"></i>
                        </div>
                        <h2 class="card-title">Installation Workflow Disabled</h2>
                        <p class="card-text text-muted">
                            The installation workflow is currently disabled. 
                            To enable it, set the <code>APP_ENABLE_INSTALL_WORKFLOW</code> environment variable to <code>true</code>.
                        </p>
                        <div class="mt-4">
                            <code class="bg-light p-2 rounded d-block">
                                APP_ENABLE_INSTALL_WORKFLOW=true
                            </code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
