{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% set title = __('user_certifications.admin.title') %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="container">
        {# Header #}
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="{{ url('/admin') }}">{{ __('admin.title') }}</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="{{ url('/admin/certifications') }}">{{ __('certifications.title') }}</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">{{ __('user_certifications.title') }}</li>
                    </ol>
                </nav>

                <h1>
                    {{ m.icon('people-fill') }}
                    {{ title }}
                </h1>
                <p class="text-muted">{{ __('user_certifications.admin.description') }}</p>
            </div>

            <div class="d-flex gap-2">
                <a href="{{ url('/admin/certifications') }}" class="btn btn-secondary">
                    {{ m.icon('arrow-left') }}
                    {{ __('certifications.back_to_list') }}
                </a>
                <a href="{{ url('/admin/certifications/create') }}" class="btn btn-primary">
                    {{ m.icon('plus') }}
                    {{ __('certifications.create.title') }}
                </a>
            </div>
        </div>

        {% include 'layouts/parts/messages.twig' %}

        {# Filters and Search #}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    {{ m.icon('funnel') }}
                    {{ __('form.filters') }}
                </h5>
            </div>
            <div class="card-body">
                <form method="GET" action="{{ url('/admin/user-certifications') }}" class="row g-3">
                    {# User Search #}
                    <div class="col-md-3">
                        {{ f.input('search_user', __('user_certifications.search_user'), {
                            'value': request.input('search_user'),
                            'placeholder': __('user_certifications.search_user.placeholder')
                        }) }}
                    </div>

                    {# Certification Filter #}
                    <div class="col-md-3">
                        {% set certification_options = {'': __('user_certifications.all_certifications')} %}
                        {% for certification in certifications %}
                            {% set certification_options = certification_options|merge({(certification.uuid): certification.title}) %}
                        {% endfor %}
                        {{ f.select('certification', __('user_certifications.certification_filter'), certification_options, {
                            'selected': request.input('certification')
                        }) }}
                    </div>

                    {# Status Filter #}
                    <div class="col-md-2">
                        {{ f.select('status', __('user_certifications.status_filter'), {
                            '': __('user_certifications.all_statuses'),
                            'pending': __('user_certifications.status.pending'),
                            'approved': __('user_certifications.status.approved'),
                            'self_confirmed': __('user_certifications.status.self_confirmed'),
                            'revoked': __('user_certifications.status.revoked'),
                            'expired': __('user_certifications.status.expired')
                        }, {
                            'selected': request.input('status')
                        }) }}
                    </div>

                    {# Department Filter #}
                    <div class="col-md-2">
                        {% set department_options = {'': __('user_certifications.all_departments')} %}
                        {% for department in departments %}
                            {% set department_options = department_options|merge({(department.id): department.name}) %}
                        {% endfor %}
                        {{ f.select('department', __('user_certifications.department_filter'), department_options, {
                            'selected': request.input('department')
                        }) }}
                    </div>

                    {# Filter Actions #}
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            {{ m.icon('search') }}
                            {{ __('form.search') }}
                        </button>
                        {% if request.input('search_user') or request.input('certification') or request.input('status') or request.input('department') %}
                            <a href="{{ url('/admin/user-certifications') }}" class="btn btn-secondary w-100 mt-1">
                                {{ m.icon('x-circle') }}
                                {{ __('form.clear') }}
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>

        {# Statistics Dashboard #}
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="h3 text-primary mb-1">{{ stats.total_users|default(0) }}</div>
                        <div class="text-muted small">{{ __('user_certifications.stats.total_users') }}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="h3 text-success mb-1">{{ stats.approved_count|default(0) }}</div>
                        <div class="text-muted small">{{ __('user_certifications.stats.approved') }}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="h3 text-warning mb-1">{{ stats.pending_count|default(0) }}</div>
                        <div class="text-muted small">{{ __('user_certifications.stats.pending') }}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="h3 text-danger mb-1">{{ stats.expired_count|default(0) }}</div>
                        <div class="text-muted small">{{ __('user_certifications.stats.expired') }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# Main Content Area #}
        <div class="row">
            {# User Certifications Table #}
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            {{ m.icon('list-check') }}
                            {{ __('user_certifications.list_title') }}
                        </h5>

                        {% if user_certifications|length > 0 %}
                            <div class="d-flex gap-2">
                                {# Bulk Actions #}
                                <div class="dropdown">
                                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        {{ m.icon('three-dots') }}
                                        {{ __('user_certifications.bulk_actions') }}
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <button type="button" class="dropdown-item" onclick="bulkAction('approve')">
                                                {{ m.icon('check-circle', 'text-success') }}
                                                {{ __('user_certifications.bulk_approve') }}
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item" onclick="bulkAction('revoke')">
                                                {{ m.icon('x-circle', 'text-danger') }}
                                                {{ __('user_certifications.bulk_revoke') }}
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#bulkAddModal">
                                                {{ m.icon('plus-circle', 'text-primary') }}
                                                {{ __('user_certifications.bulk_add') }}
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {% if user_certifications|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 40px;">
                                            <input type="checkbox" id="selectAll" class="form-check-input">
                                        </th>
                                        <th>
                                            <a href="{{ url('/admin/user-certifications')|merge_query_params({'sort': 'user_name', 'direction': request.input('direction') == 'asc' ? 'desc' : 'asc'}) }}"
                                               class="text-decoration-none text-dark">
                                                {{ __('user_certifications.user') }}
                                                {% if request.input('sort') == 'user_name' %}
                                                    {{ m.icon(request.input('direction') == 'asc' ? 'chevron-up' : 'chevron-down') }}
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="{{ url('/admin/user-certifications')|merge_query_params({'sort': 'certification_title', 'direction': request.input('direction') == 'asc' ? 'desc' : 'asc'}) }}"
                                               class="text-decoration-none text-dark">
                                                {{ __('user_certifications.certification') }}
                                                {% if request.input('sort') == 'certification_title' %}
                                                    {{ m.icon(request.input('direction') == 'asc' ? 'chevron-up' : 'chevron-down') }}
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="{{ url('/admin/user-certifications')|merge_query_params({'sort': 'status', 'direction': request.input('direction') == 'asc' ? 'desc' : 'asc'}) }}"
                                               class="text-decoration-none text-dark">
                                                {{ __('user_certifications.status') }}
                                                {% if request.input('sort') == 'status' %}
                                                    {{ m.icon(request.input('direction') == 'asc' ? 'chevron-up' : 'chevron-down') }}
                                                {% endif %}
                                            </a>
                                        </th>
                                        <th>{{ __('user_certifications.expires') }}</th>
                                        <th>{{ __('user_certifications.department') }}</th>
                                        <th style="width: 120px;">{{ __('form.actions') }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user_cert in user_certifications %}
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="form-check-input row-select" value="{{ user_cert.pivot.id }}">
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <strong>{{ user_cert.user.name }}</strong>
                                                    <div class="text-muted small mt-1">{{ user_cert.user.email }}</div>
                                                </div>
                                            </td>
                                            <td>
                                                <a href="{{ url('/admin/certifications/' ~ user_cert.certification.uuid) }}"
                                                   class="text-decoration-none">
                                                    {{ user_cert.certification.title }}
                                                </a>
                                            </td>
                                            <td>
                                                {% include 'components/certification-status-badge.twig' with {'status': user_cert.pivot.status} %}
                                            </td>
                                            <td>
                                                {% if user_cert.pivot.date_expires %}
                                                    {% set is_expiring_soon = user_cert.pivot.date_expires|date('Y-m-d') <= 'now'|date_modify('+30 days')|date('Y-m-d') %}
                                                    <span class="{{ is_expiring_soon ? 'text-warning' : '' }}">
                                                        {{ user_cert.pivot.date_expires|date('Y-m-d') }}
                                                        {% if is_expiring_soon %}
                                                            {{ m.icon('exclamation-triangle', 'text-warning') }}
                                                        {% endif %}
                                                    </span>
                                                {% else %}
                                                    <span class="text-muted">{{ __('user_certifications.never') }}</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if user_cert.user.angel_types|length > 0 %}
                                                    {{ user_cert.user.angel_types|map(u => u.name)|join(', ')|slice(0, 30) }}{% if user_cert.user.angel_types|map(u => u.name)|join(', ')|length > 30 %}...{% endif %}
                                                {% else %}
                                                    <span class="text-muted">{{ __('user_certifications.no_department') }}</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="dropdown">
                                                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                        {{ m.icon('three-dots') }}
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        {% if user_cert.pivot.status == 'pending' %}
                                                            <li>
                                                                <button type="button" class="dropdown-item" onclick="updateStatus({{ user_cert.pivot.id }}, 'approved')">
                                                                    {{ m.icon('check-circle', 'text-success') }}
                                                                    {{ __('user_certifications.approve') }}
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                        {% if user_cert.pivot.status in ['approved', 'self_confirmed'] %}
                                                            <li>
                                                                <button type="button" class="dropdown-item" onclick="updateStatus({{ user_cert.pivot.id }}, 'revoked')">
                                                                    {{ m.icon('x-circle', 'text-danger') }}
                                                                    {{ __('user_certifications.revoke') }}
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                        {% if user_cert.pivot.status == 'revoked' %}
                                                            <li>
                                                                <button type="button" class="dropdown-item" onclick="updateStatus({{ user_cert.pivot.id }}, 'approved')">
                                                                    {{ m.icon('arrow-clockwise', 'text-primary') }}
                                                                    {{ __('user_certifications.restore') }}
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <button type="button" class="dropdown-item" onclick="editExpiry({{ user_cert.pivot.id }}, '{{ user_cert.pivot.date_expires|date('Y-m-d') }}')">
                                                                {{ m.icon('calendar-event') }}
                                                                {{ __('user_certifications.edit_expiry') }}
                                                            </button>
                                                        </li>
                                                        <li>
                                                            <button type="button" class="dropdown-item" onclick="addNote({{ user_cert.pivot.id }})">
                                                                {{ m.icon('note-sticky') }}
                                                                {{ __('user_certifications.add_note') }}
                                                            </button>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <button type="button" class="dropdown-item text-danger" onclick="deleteUserCertification({{ user_cert.pivot.id }})">
                                                                {{ m.icon('trash') }}
                                                                {{ __('form.delete') }}
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="card-body text-center py-5">
                            <div class="text-muted">
                                {{ m.icon('inbox', 'fs-1 mb-3') }}
                                <h5>{{ __('user_certifications.no_results') }}</h5>
                                <p>{{ __('user_certifications.no_results_description') }}</p>
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Pagination #}
                {% if user_certifications.last_page is defined and user_certifications.last_page > 1 %}
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="pagination-info">
                            <small class="text-muted">
                                {{ __('pagination.showing') }} {{ user_certifications.from }} {{ __('pagination.to') }} {{ user_certifications.to }} {{ __('pagination.of') }} {{ user_certifications.total }} {{ __('pagination.results') }}
                            </small>
                        </div>
                        <nav aria-label="{{ __('pagination.navigation') }}">
                            <ul class="pagination mb-0">
                                {# Previous Page Link #}
                                {% if user_certifications.current_page == 1 %}
                                    <li class="page-item disabled">
                                        <span class="page-link">{{ __('pagination.previous') }}</span>
                                    </li>
                                {% else %}
                                    {% set prev_page = user_certifications.current_page - 1 %}
                                    {% set prev_params = [] %}
                                    {% for key, value in filter_state %}
                                        {% if key != 'page' and value %}
                                            {% set prev_params = prev_params|merge([key ~ '=' ~ value|url_encode]) %}
                                        {% endif %}
                                    {% endfor %}
                                    {% set prev_params = prev_params|merge(['page=' ~ prev_page]) %}
                                    {% set prev_url = url('/admin/user-certifications') ~ '?' ~ prev_params|join('&') %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ prev_url }}">
                                            {{ __('pagination.previous') }}
                                        </a>
                                    </li>
                                {% endif %}

                                {# Pagination Elements #}
                                {% set start_page = max(1, user_certifications.current_page - 2) %}
                                {% set end_page = min(user_certifications.last_page, user_certifications.current_page + 2) %}

                                {% if start_page > 1 %}
                                    {% set first_params = [] %}
                                    {% for key, value in filter_state %}
                                        {% if key != 'page' and value %}
                                            {% set first_params = first_params|merge([key ~ '=' ~ value|url_encode]) %}
                                        {% endif %}
                                    {% endfor %}
                                    {% set first_params = first_params|merge(['page=1']) %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ url('/admin/user-certifications') ~ '?' ~ first_params|join('&') }}">1</a>
                                    </li>
                                    {% if start_page > 2 %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    {% endif %}
                                {% endif %}

                                {% for page in start_page..end_page %}
                                    {% if page == user_certifications.current_page %}
                                        <li class="page-item active">
                                            <span class="page-link">{{ page }}</span>
                                        </li>
                                    {% else %}
                                        {% set page_params = [] %}
                                        {% for key, value in filter_state %}
                                            {% if key != 'page' and value %}
                                                {% set page_params = page_params|merge([key ~ '=' ~ value|url_encode]) %}
                                            {% endif %}
                                        {% endfor %}
                                        {% set page_params = page_params|merge(['page=' ~ page]) %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url('/admin/user-certifications') ~ '?' ~ page_params|join('&') }}">{{ page }}</a>
                                        </li>
                                    {% endif %}
                                {% endfor %}

                                {% if end_page < user_certifications.last_page %}
                                    {% if end_page < user_certifications.last_page - 1 %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    {% endif %}
                                    {% set last_params = [] %}
                                    {% for key, value in filter_state %}
                                        {% if key != 'page' and value %}
                                            {% set last_params = last_params|merge([key ~ '=' ~ value|url_encode]) %}
                                        {% endif %}
                                    {% endfor %}
                                    {% set last_params = last_params|merge(['page=' ~ user_certifications.last_page]) %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ url('/admin/user-certifications') ~ '?' ~ last_params|join('&') }}">{{ user_certifications.last_page }}</a>
                                    </li>
                                {% endif %}

                                {# Next Page Link #}
                                {% if user_certifications.current_page == user_certifications.last_page %}
                                    <li class="page-item disabled">
                                        <span class="page-link">{{ __('pagination.next') }}</span>
                                    </li>
                                {% else %}
                                    {% set next_page = user_certifications.current_page + 1 %}
                                    {% set next_params = [] %}
                                    {% for key, value in filter_state %}
                                        {% if key != 'page' and value %}
                                            {% set next_params = next_params|merge([key ~ '=' ~ value|url_encode]) %}
                                        {% endif %}
                                    {% endfor %}
                                    {% set next_params = next_params|merge(['page=' ~ next_page]) %}
                                    {% set next_url = url('/admin/user-certifications') ~ '?' ~ next_params|join('&') %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ next_url }}">
                                            {{ __('pagination.next') }}
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>
                        </nav>
                    </div>
                {% endif %}
            </div>

            {# Sidebar with Quick Actions #}
            <div class="col-lg-4">
                {# Quick Add Certification #}
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            {{ m.icon('plus-circle') }}
                            {{ __('user_certifications.quick_add') }}
                        </h5>
                    </div>
                    <div class="card-body">
                        <form id="quickAddForm">
                            {{ csrf() }}

                            <div class="mb-3">
                                {{ f.select('user_id', __('user_certifications.select_user'), {
                                    '': __('user_certifications.select_user_placeholder')
                                }, {
                                    'id': 'userSelect',
                                    'required': true
                                }) }}
                            </div>

                            <div class="mb-3">
                                {% set cert_options = {'': __('user_certifications.select_certification_placeholder')} %}
                                {% for certification in certifications %}
                                    {% set cert_options = cert_options|merge({(certification.uuid): certification.title}) %}
                                {% endfor %}
                                {{ f.select('certification_uuid', __('user_certifications.select_certification'), cert_options, {
                                    'required': true
                                }) }}
                            </div>

                            <div class="mb-3">
                                {{ f.select('status', __('user_certifications.initial_status'), {
                                    'pending': __('user_certifications.status.pending'),
                                    'approved': __('user_certifications.status.approved'),
                                    'self_confirmed': __('user_certifications.status.self_confirmed')
                                }, {
                                    'selected': 'pending',
                                    'required': true
                                }) }}
                            </div>

                            <div class="mb-3">
                                {{ f.input('notes', __('user_certifications.notes'), {
                                    'type': 'text',
                                    'placeholder': __('user_certifications.notes_placeholder')
                                }) }}
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                {{ m.icon('plus') }}
                                {{ __('user_certifications.add_certification') }}
                            </button>
                        </form>
                    </div>
                </div>

                {# Filter Summary #}
                {% if request.input('search_user') or request.input('certification') or request.input('status') or request.input('department') %}
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="mb-0">
                                {{ m.icon('funnel') }}
                                {{ __('user_certifications.active_filters') }}
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if request.input('search_user') %}
                                <span class="badge bg-primary me-1 mb-1">
                                    {{ __('user_certifications.user') }}: {{ request.input('search_user') }}
                                </span>
                            {% endif %}
                            {% if request.input('certification') %}
                                <span class="badge bg-primary me-1 mb-1">
                                    {{ __('user_certifications.certification') }}: {{ certifications|filter(c => c.uuid == request.input('certification'))|first.title|default('N/A') }}
                                </span>
                            {% endif %}
                            {% if request.input('status') %}
                                <span class="badge bg-primary me-1 mb-1">
                                    {{ __('user_certifications.status') }}: {{ __('user_certifications.status.' ~ request.input('status')) }}
                                </span>
                            {% endif %}
                            {% if request.input('department') %}
                                <span class="badge bg-primary me-1 mb-1">
                                    {{ __('user_certifications.department') }}: {{ departments|filter(d => d.id == request.input('department'))|first.name|default('N/A') }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {# Recent Activity #}
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">
                            {{ m.icon('clock') }}
                            {{ __('user_certifications.recent_activity') }}
                        </h5>
                    </div>
                    <div class="card-body">
                        {% if recent_activity|length > 0 %}
                            <div class="timeline">
                                {% for activity in recent_activity %}
                                    <div class="timeline-item small mb-2">
                                        <div class="fw-semibold">{{ activity.user_name }}</div>
                                        <div class="text-muted">
                                            {{ activity.action }} {{ activity.certification_title }}
                                        </div>
                                        <div class="text-muted small">{{ activity.created_at|date('M j, H:i') }}</div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-muted small text-center">
                                {{ __('user_certifications.no_recent_activity') }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Modals #}
    {% include 'admin/user-certifications/modals.twig' %}

    {# JavaScript for Dynamic Functionality #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // User search with autocomplete
            const userSelect = document.getElementById('userSelect');
            if (userSelect) {
                // Initialize user search functionality
                initializeUserSearch(userSelect);
            }

            // Select all functionality
            const selectAllCheckbox = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-select');

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function() {
                    rowCheckboxes.forEach(checkbox => {
                        checkbox.checked = this.checked;
                    });
                });
            }

            // Individual checkbox change
            rowCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const allChecked = Array.from(rowCheckboxes).every(cb => cb.checked);
                    const noneChecked = Array.from(rowCheckboxes).every(cb => !cb.checked);

                    if (selectAllCheckbox) {
                        selectAllCheckbox.checked = allChecked;
                        selectAllCheckbox.indeterminate = !allChecked && !noneChecked;
                    }
                });
            });

            // Quick add form submission
            const quickAddForm = document.getElementById('quickAddForm');
            if (quickAddForm) {
                quickAddForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    submitQuickAdd(this);
                });
            }
        });

        function initializeUserSearch(selectElement) {
            // Simple user search implementation
            // In a real implementation, this would use AJAX for autocomplete
            console.log('User search initialized for:', selectElement);
        }

        function updateStatus(userCertId, newStatus) {
            if (confirm('{{ __('user_certifications.confirm_status_change') }}')) {
                fetch(`{{ url('/admin/user-certifications') }}/${userCertId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    body: JSON.stringify({ status: newStatus })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('{{ __('form.error_occurred') }}');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('{{ __('form.error_occurred') }}');
                });
            }
        }

        function editExpiry(userCertId, currentDate) {
            const newDate = prompt('{{ __('user_certifications.enter_new_expiry') }}', currentDate);
            if (newDate) {
                updateStatus(userCertId, null, { date_expires: newDate });
            }
        }

        function addNote(userCertId) {
            const note = prompt('{{ __('user_certifications.enter_note') }}');
            if (note) {
                updateStatus(userCertId, null, { notes: note });
            }
        }

        function deleteUserCertification(userCertId) {
            if (confirm('{{ __('user_certifications.confirm_delete') }}')) {
                fetch(`{{ url('/admin/user-certifications') }}/${userCertId}`, {
                    method: 'DELETE',
                    headers: {
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('{{ __('form.error_occurred') }}');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('{{ __('form.error_occurred') }}');
                });
            }
        }

        function bulkAction(action) {
            const selectedIds = Array.from(document.querySelectorAll('.row-select:checked')).map(cb => cb.value);

            if (selectedIds.length === 0) {
                alert('{{ __('user_certifications.select_items_first') }}');
                return;
            }

            if (confirm(`{{ __('user_certifications.confirm_bulk_action') }} ${selectedIds.length} {{ __('user_certifications.items') }}?`)) {
                fetch('{{ url('/admin/user-certifications/bulk') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    body: JSON.stringify({ action: action, ids: selectedIds })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('{{ __('form.error_occurred') }}');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('{{ __('form.error_occurred') }}');
                });
            }
        }

        function submitQuickAdd(form) {
            const formData = new FormData(form);

            fetch('{{ url('/admin/user-certifications') }}', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || '{{ __('form.error_occurred') }}');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('{{ __('form.error_occurred') }}');
            });
        }
    </script>
