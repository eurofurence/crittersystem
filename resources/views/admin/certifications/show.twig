{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ certification.title }}{% endblock %}

{% block content %}
    <div class="container">
        {# Header with Navigation #}
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
{#                 <nav aria-label="breadcrumb"> #}
{#                     <ol class="breadcrumb"> #}
{#                         <li class="breadcrumb-item"> #}
{#                             <a href="{{ url('/admin/certifications') }}">{{ __('certifications.title') }}</a> #}
{#                         </li> #}
{#                         <li class="breadcrumb-item active" aria-current="page">{{ certification.title }}</li> #}
{#                     </ol> #}
{#                 </nav> #}

                <h1 class="mb-0">
                    {% if certification.is_active %}
                        <span class="badge bg-success me-2">{{ m.icon('check-circle') }}</span>
                    {% else %}
                        <span class="badge bg-secondary me-2">{{ m.icon('x-circle') }}</span>
                    {% endif %}
                    {{ certification.title }}
                </h1>

                {% if certification.description %}
                    <p class="text-muted mt-2">{{ certification.description }}</p>
                {% endif %}
            </div>

            {# Action Buttons #}
            {% if can('admin_certificates') or can('certificates.manage') %}
                <div class="btn-group" role="group">
                    <a href="{{ url('/admin/certifications/' ~ certification.uuid ~ '/edit') }}"
                       class="btn btn-primary">
                        {{ m.icon('pencil') }}
                        {{ __('form.edit') }}
                    </a>

                    {% if certification.is_active and not certification.allow_self_confirmation %}
                        <a href="{{ url('/admin/certifications/' ~ certification.uuid ~ '/qr') }}"
                           class="btn btn-info"
                           title="{{ __('Show QR code for certification confirmation') }}">
                            {{ m.icon('qr-code') }}
                            {{ __('QR Code') }}
                        </a>
                    {% endif %}

                    {% if certification.is_active %}
                        <form method="post" action="{{ url('/admin/certifications/' ~ certification.uuid ~ '/deactivate') }}" class="d-inline">
                            {{ csrf() }}
                            {{ f.hidden('uuid', certification.uuid) }}
                            {{ f.hidden('deactivate', 'on') }}
                            <button type="submit"
                                    class="btn btn-warning"
                                    onclick="return confirm('{{ __('certifications.deactivate.confirm', [certification.title|e]) }}')">
                                {{ m.icon('pause-circle') }}
                                {{ __('certifications.deactivate') }}
                            </button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ url('/admin/certifications/' ~ certification.uuid ~ '/reactivate') }}" class="d-inline">
                            {{ csrf() }}
                            {{ f.hidden('uuid', certification.uuid) }}
                            {{ f.hidden('reactivate', 'on') }}
                            <button type="submit" class="btn btn-success">
                                {{ m.icon('play-circle') }}
                                {{ __('certifications.reactivate') }}
                            </button>
                        </form>
                    {% endif %}

                    <div class="btn-group" role="group">
                        <button type="button"
                                class="btn btn-danger dropdown-toggle"
                                data-bs-toggle="dropdown">
                            {{ __('certifications.more_actions') }}
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <form method="post" action="{{ url('/admin/certifications/' ~ certification.uuid ~ '/mass-revoke') }}" class="d-inline w-100">
                                    {{ csrf() }}
                                    {{ f.hidden('uuid', certification.uuid) }}
                                    {{ f.hidden('mass_revoke', 'on') }}
                                    <button type="submit"
                                            class="dropdown-item text-warning"
                                            onclick="return confirm('{{ __('certifications.mass_revoke.confirm', [certification.title|e]) }}')">
                                        {{ m.icon('person-x') }}
                                        {{ __('certifications.mass_revoke') }}
                                    </button>
                                </form>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="{{ url('/admin/certifications/' ~ certification.uuid ~ '/delete') }}" class="d-inline w-100">
                                    {{ csrf() }}
                                    {{ f.hidden('uuid', certification.uuid) }}
                                    {{ f.hidden('delete', 'on') }}
                                    <button type="submit"
                                            class="dropdown-item text-danger"
                                            onclick="return confirm('{{ __('certifications.delete.confirm', [certification.title|e]) }}')">
                                        {{ m.icon('trash') }}
                                        {{ __('form.delete') }}
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            {% endif %}
        </div>

        {% include 'layouts/parts/messages.twig' %}

        <div class="row">
            {# Certification Details #}
            <div class="col-lg-4 mb-4">
                <div class="card border-secondary {{ m.type_bg_class() }}">
                    <div class="card-header bg-secondary">
                        <h5 class="mb-0">
                            {{ m.icon('info-circle') }}
                            {{ __('certifications.details') }}
                        </h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-5">{{ __('certifications.status') }}:</dt>
                            <dd class="col-sm-7">
                                {% if certification.is_active %}
                                    <span class="badge bg-success">{{ __('certifications.active') }}</span>
                                {% else %}
                                    <span class="badge bg-danger">{{ __('certifications.inactive') }}</span>
                                {% endif %}
                            </dd>

                            <dt class="col-sm-5">{{ __('certifications.validity') }}:</dt>
                            <dd class="col-sm-7">
                                {% if certification.is_perpetual %}
                                    <span class="badge bg-info">
                                        {{ m.icon('infinity') }}
                                        {{ __('certifications.perpetual') }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">
                                        {{ m.icon('clock') }}
                                        {{ __('certifications.valid_for_days', {'days': certification.validity_period_days}) }}
                                    </span>
                                {% endif %}
                            </dd>

                            <dt class="col-sm-5">{{ __('certifications.self_confirmation') }}:</dt>
                            <dd class="col-sm-7">
                                {% if certification.allow_self_confirmation %}
                                    <span class="badge bg-primary">
                                        {{ m.icon('person-check') }}
                                        {{ __('certifications.self_confirmable') }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        {{ m.icon('person-x') }}
                                        {{ __('certifications.not_self_confirmable') }}
                                    </span>
                                {% endif %}
                            </dd>

                            {% if certification.contact_person %}
                                <dt class="col-sm-5">{{ __('certifications.contact_person') }}:</dt>
                                <dd class="col-sm-7">{{ certification.contact_person }}</dd>
                            {% endif %}

                            {% if certification.contact_email %}
                                <dt class="col-sm-5">{{ __('certifications.contact_email') }}:</dt>
                                <dd class="col-sm-7">
                                    <a href="mailto:{{ certification.contact_email }}">
                                        {{ m.icon('envelope') }}
                                        {{ certification.contact_email }}
                                    </a>
                                </dd>
                            {% endif %}

                            {% if certification.location %}
                                <dt class="col-sm-5">{{ __('certifications.location') }}:</dt>
                                <dd class="col-sm-7">{{ certification.location }}</dd>
                            {% endif %}

                            <dt class="col-sm-5">{{ __('certifications.created_at') }}:</dt>
                            <dd class="col-sm-7">
                                <small class="text-muted">{{ certification.created_at|date('Y-m-d H:i:s') }}</small>
                            </dd>

                            {% if certification.updated_at != certification.created_at %}
                                <dt class="col-sm-5">{{ __('certifications.updated_at') }}:</dt>
                                <dd class="col-sm-7">
                                    <small class="text-muted">{{ certification.updated_at|date('Y-m-d H:i:s') }}</small>
                                </dd>
                            {% endif %}
                        </dl>
                    </div>
                </div>

                {# Statistics Card #}
                <div class="card mt-4 border-secondary {{ m.type_bg_class() }}">
                    <div class="card-header bg-secondary">
                        <h5 class="mb-0">
                            {{ m.icon('bar-chart') }}
                            {{ __('certifications.statistics') }}
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="border-end">
                                    <h4 class="text-primary">{{ userCounts.total|default(0) }}</h4>
                                    <small class="text-muted">{{ __('certifications.total_critters') }}</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <h4 class="text-success">{{ userCounts.approved|default(0) }}</h4>
                                <small class="text-muted">{{ __('certifications.approved_critters') }}</small>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="row text-center">
                            <div class="col-3">
                                <div class="border-end">
                                    <h6 class="text-warning">{{ userCounts.pending|default(0) }}</h6>
                                    <small class="text-muted">{{ __('certifications.status.pending') }}</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="border-end">
                                    <h6 class="text-info">{{ userCounts.self_confirmed|default(0) }}</h6>
                                    <small class="text-muted">{{ __('certifications.status.self_confirmed') }}</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="border-end">
                                    <h6 class="text-danger">{{ userCounts.revoked|default(0) }}</h6>
                                    <small class="text-muted">{{ __('certifications.status.revoked') }}</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <h6 class="text-secondary">{{ userCounts.expired|default(0) }}</h6>
                                <small class="text-muted">{{ __('certifications.status.expired') }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# User Lists #}
            <div class="col-lg-8">
                {# Status Filter Tabs with enhanced badges #}
                <ul class="nav nav-tabs" id="statusTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                            <span class="badge bg-success me-1">{{ userCounts.approved|default(0) }}</span>
                            {{ m.icon('check-circle') }}
                            {{ __('certifications.status.approved') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="self-confirmed-tab" data-bs-toggle="tab" data-bs-target="#self-confirmed" type="button" role="tab">
                            <span class="badge bg-info me-1">{{ userCounts.self_confirmed|default(0) }}</span>
                            {{ m.icon('person-check') }}
                            {{ __('certifications.status.self_confirmed') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link position-relative" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                            <span class="badge bg-warning me-1">{{ userCounts.pending|default(0) }}</span>
                            {{ m.icon('clock') }}
                            {{ __('certifications.status.pending') }}
                            {% if userCounts.pending|default(0) > 0 %}
                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-warning border border-light rounded-circle">
                                    <span class="visually-hidden">Pending approvals</span>
                                </span>
                            {% endif %}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="revoked-tab" data-bs-toggle="tab" data-bs-target="#revoked" type="button" role="tab">
                            <span class="badge bg-danger me-1">{{ userCounts.revoked|default(0) }}</span>
                            {{ m.icon('x-circle') }}
                            {{ __('certifications.status.revoked') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="expired-tab" data-bs-toggle="tab" data-bs-target="#expired" type="button" role="tab">
                            <span class="badge bg-secondary me-1">{{ userCounts.expired|default(0) }}</span>
                            {{ m.icon('calendar-x') }}
                            {{ __('certifications.status.expired') }}
                        </button>
                    </li>
                </ul>

                {# Tab Content #}
                <div class="tab-content" id="statusTabContent">
                    {# Approved Users #}
                    <div class="tab-pane fade show active" id="approved" role="tabpanel">
                        {{ _self.renderUserTable(usersByStatus.approved|default([]), 'approved', certification) }}
                    </div>

                    {# Self-Confirmed Users #}
                    <div class="tab-pane fade" id="self-confirmed" role="tabpanel">
                        {{ _self.renderUserTable(usersByStatus.self_confirmed|default([]), 'self_confirmed', certification) }}
                    </div>

                    {# Pending Users #}
                    <div class="tab-pane fade" id="pending" role="tabpanel">
                        {{ _self.renderUserTable(usersByStatus.pending|default([]), 'pending', certification) }}
                    </div>

                    {# Revoked Users #}
                    <div class="tab-pane fade" id="revoked" role="tabpanel">
                        {{ _self.renderUserTable(usersByStatus.revoked|default([]), 'revoked', certification) }}
                    </div>

                    {# Expired Users #}
                    <div class="tab-pane fade" id="expired" role="tabpanel">
                        {{ _self.renderUserTable(usersByStatus.expired|default([]), 'expired', certification) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{# Macro for rendering user tables #}
{% macro renderUserTable(users, status, certification) %}
    {% import 'macros/base.twig' as m %}
    {% import 'macros/form.twig' as f %}

    <div class="card mt-3 border-secondary {{ m.type_bg_class() }}">
        <div class="card-header d-flex justify-content-between align-items-center bg-secondary">
            <h6 class="mb-0">
                {% set statusIcons = {
                    'approved': 'check-circle',
                    'self_confirmed': 'person-check',
                    'pending': 'clock',
                    'revoked': 'x-circle',
                    'expired': 'calendar-x'
                } %}
                {% set statusClasses = {
                    'approved': 'success',
                    'self_confirmed': 'info',
                    'pending': 'warning',
                    'revoked': 'danger',
                    'expired': 'secondary'
                } %}
                {{ m.icon(statusIcons[status]) }}
                {{ __(('certifications.status.' ~ status)) }}
                <span class="badge bg-{{ statusClasses[status] }} ms-2">{{ users|length }}</span>
            </h6>

            {% if users|length > 0 %}
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        {{ m.icon('funnel') }} Sort
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name" data-target="{{ status }}">
                            {{ m.icon('sort-alpha-down') }} Name A-Z
                        </a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-desc" data-target="{{ status }}">
                            {{ m.icon('sort-alpha-up') }} Name Z-A
                        </a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="date" data-target="{{ status }}">
                            {{ m.icon('calendar-plus') }} Date (Newest)
                        </a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="date-desc" data-target="{{ status }}">
                            {{ m.icon('calendar-minus') }} Date (Oldest)
                        </a></li>
                        {% if not certification.is_perpetual %}
                        <li><a class="dropdown-item sort-option" href="#" data-sort="expires" data-target="{{ status }}">
                            {{ m.icon('hourglass-split') }} Expiry (Soonest)
                        </a></li>
                        {% endif %}
                    </ul>
                </div>
            {% endif %}
        </div>
        <div class="card-body">
            {% if users|length > 0 %}
                {# Bulk Actions for pending status #}
                {% if status == 'pending' and (can('admin_certificates') or can('certificates.manage')) %}
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="select-all-{{ status }}" data-target="{{ status }}">
                            <label class="form-check-label" for="select-all-{{ status }}">
                                Select All
                            </label>
                        </div>
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-success btn-sm"
                                    id="bulk-approve-{{ status }}"
                                    data-bulk-action="approve"
                                    data-status="{{ status }}"
                                    data-certification-id="{{ certification.id }}"
                                    disabled>
                                {{ m.icon('check') }} Bulk Approve
                            </button>
                        </div>
                    </div>
                {% endif %}

                {# Bulk Actions for approved/self_confirmed status #}
                {% if status in ['approved', 'self_confirmed'] and (can('admin_certificates') or can('certificates.manage')) %}
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="select-all-{{ status }}" data-target="{{ status }}">
                            <label class="form-check-label" for="select-all-{{ status }}">
                                Select All
                            </label>
                        </div>
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    id="bulk-revoke-{{ status }}"
                                    data-bulk-action="revoke"
                                    data-status="{{ status }}"
                                    data-certification-id="{{ certification.id }}"
                                    disabled>
                                {{ m.icon('x') }} Bulk Revoke
                            </button>
                        </div>
                    </div>
                {% endif %}

                <div class="table-responsive">
                    <table class="table table-sm table-hover" id="users-table-{{ status }}">
                        <thead class="table-dark">
                            <tr>
                                {% if (status == 'pending' or status in ['approved', 'self_confirmed']) and (can('admin_certificates') or can('certificates.manage')) %}
                                    <th width="40">
                                        <input class="form-check-input" type="checkbox" id="select-all-header-{{ status }}" data-target="{{ status }}">
                                    </th>
                                {% endif %}
                                <th class="sortable" data-sort="name">
                                    {{ __('general.name') }}
                                    <i class="fa fa-sort text-muted ms-1"></i>
                                </th>
                                <th class="sortable" data-sort="certified_at">
                                    {{ __('certifications.date_certified') }}
                                    <i class="fa fa-sort text-muted ms-1"></i>
                                </th>
                                {% if not certification.is_perpetual %}
                                    <th class="sortable" data-sort="expires_at">
                                        {{ __('certifications.expires_at') }}
                                        <i class="fa fa-sort text-muted ms-1"></i>
                                    </th>
                                {% endif %}
                                <th>{{ __('certifications.notes') }}</th>
                                {% if can('admin_certificates') or can('certificates.manage') %}
                                    <th class="text-end">{{ __('form.actions') }}</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody class="sortable-tbody" data-status="{{ status }}">
                            {% for userCert in users %}
                                <tr data-user-name="{{ userCert.name|lower }}"
                                    data-certified-at="{{ userCert.pivot.created_at }}"
                                    {% if not certification.is_perpetual and userCert.pivot.expires_at %}
                                        data-expires-at="{{ userCert.pivot.expires_at }}"
                                    {% endif %}>
                                    {% if (status == 'pending' or status in ['approved', 'self_confirmed']) and (can('admin_certificates') or can('certificates.manage')) %}
                                        <td>
                                            <input class="form-check-input bulk-select"
                                                   type="checkbox"
                                                   name="certification_ids[]"
                                                   value="{{ userCert.pivot.id }}"
                                                   data-status="{{ status }}">
                                        </td>
                                    {% endif %}
                                    <td>
                                        <div class="d-flex align-items-center">
                                            {% set statusClass = {
                                                'approved': 'success',
                                                'self_confirmed': 'info',
                                                'pending': 'warning',
                                                'revoked': 'danger',
                                                'expired': 'secondary'
                                            } %}
                                            {% set statusIcon = {
                                                'approved': 'check-circle',
                                                'self_confirmed': 'person-check',
                                                'pending': 'clock',
                                                'revoked': 'x-circle',
                                                'expired': 'calendar-x'
                                            } %}
                                            <span class="badge bg-{{ statusClass[status] }} me-2" title="{{ __(('certifications.status.' ~ status)) }}">
                                                {{ m.icon(statusIcon[status], 12) }}
                                            </span>
                                            <div>
                                                {% if userCert %}
                                                    <strong>{{ userCert.name }}</strong>
                                                    {% if userCert.id %}
                                                        <br>
                                                        <small class="text-muted">ID: {{ userCert.id }}</small>
                                                    {% endif %}
                                                {% else %}
                                                    <strong class="text-danger">Unknown User</strong>
                                                    <br>
                                                    <small class="text-muted">User may have been deleted</small>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% if userCert.pivot.date_certified %}
                                            <div>
                                                <strong>{{ userCert.pivot.date_certified|date('M j, Y') }}</strong>
                                                <br>
                                                <small class="text-muted">{{ userCert.pivot.date_certified|date('g:i A') }}</small>
                                            </div>
                                        {% elseif userCert.pivot.created_at %}
                                            <div>
                                                <strong>{{ userCert.pivot.created_at|date('M j, Y') }}</strong>
                                                <br>
                                                <small class="text-muted">{{ userCert.pivot.created_at|date('g:i A') }}</small>
                                            </div>
                                        {% else %}
                                            <span class="text-muted">
                                                {{ m.icon('calendar-x') }}
                                                {{ __('form.not_specified') }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    {% if not certification.is_perpetual %}
                                        <td>
                                            {% if userCert.pivot.date_expires %}
                                                {% set expiryDate = userCert.pivot.date_expires|date('Y-m-d') %}
                                                {% set today = 'now'|date('Y-m-d') %}
                                                {% set isExpired = expiryDate < today %}
                                                {% set daysToExpiry = (userCert.pivot.date_expires|date('U') - 'now'|date('U')) / 86400 %}
                                                {% set isExpiringSoon = not isExpired and daysToExpiry <= 30 %}

                                                <div class="d-flex align-items-center">
                                                    {% if isExpired %}
                                                        <span class="badge bg-danger me-2">
                                                            {{ m.icon('exclamation-triangle', 12) }}
                                                            Expired
                                                        </span>
                                                    {% elseif isExpiringSoon %}
                                                        <span class="badge bg-warning text-dark me-2">
                                                            {{ m.icon('clock', 12) }}
                                                            {{ daysToExpiry|round }} days
                                                        </span>
                                                    {% else %}
                                                        <span class="badge bg-success me-2">
                                                            {{ m.icon('check-circle', 12) }}
                                                            Valid
                                                        </span>
                                                    {% endif %}
                                                    <div>
                                                        <strong class="{% if isExpired %}text-danger{% elseif isExpiringSoon %}text-warning{% endif %}">
                                                            {{ userCert.pivot.date_expires|date('M j, Y') }}
                                                        </strong>
                                                    </div>
                                                </div>
                                            {% else %}
                                                <span class="text-muted">{{ __('certifications.no_expiry') }}</span>
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                    <td>
                                        {% if userCert.notes %}
                                            <small>{{ userCert.notes|slice(0, 50) }}{% if userCert.notes|length > 50 %}...{% endif %}</small>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    {% if can('admin_certificates') or can('certificates.manage') %}
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="{{ url('/admin/user/' ~ userCert.id ~ '/certifications') }}"
                                                   class="btn btn-sm btn-info"
                                                   title="{{ __('certifications.view_user_certs') }}">
                                                    {{ m.icon('person') }}
                                                </a>

                                                {% if status == 'pending' %}
                                                    <form method="post" action="{{ url('/admin/user/' ~ userCert.id ~ '/certifications/' ~ userCert.pivot.id ~ '/update') }}" class="d-inline" data-action-form="approve">
                                                        {{ csrf() }}
                                                        {{ f.hidden('status', 'approved') }}
                                                        {{ f.hidden('checked', 'on') }}
                                                        <button type="submit"
                                                                class="btn btn-success btn-sm"
                                                                data-action="approve"
                                                                data-user-id="{{ userCert.id }}"
                                                                data-cert-id="{{ userCert.pivot.id }}"
                                                                data-user-name="{{ userCert.name|e }}"
                                                                title="{{ __('certifications.approve') }}">
                                                            {{ m.icon('check') }} Approve
                                                        </button>
                                                    </form>
                                                {% endif %}

                                                {% if status in ['approved', 'self_confirmed'] %}
                                                    <form method="post" action="{{ url('/admin/user/' ~ userCert.id ~ '/certifications/' ~ userCert.pivot.id ~ '/delete') }}" class="d-inline" data-action-form="revoke">
                                                        {{ csrf() }}
                                                        {{ f.hidden('status', 'revoked') }}
                                                        {{ f.hidden('checked', 'on') }}
                                                        <button type="submit"
                                                                class="btn btn-warning btn-sm"
                                                                data-action="revoke"
                                                                data-user-id="{{ userCert.id }}"
                                                                data-cert-id="{{ userCert.pivot.id }}"
                                                                data-user-name="{{ userCert.name|e }}"
                                                                title="{{ __('certifications.revoke') }}">
                                                            {{ m.icon('x') }} Revoke
                                                        </button>
                                                    </form>
                                                {% endif %}

                                                {% if status == 'revoked' %}
                                                    <form method="post" action="{{ url('/admin/user/' ~ userCert.id ~ '/certifications/' ~ userCert.pivot.id ~ '/update') }}" class="d-inline" data-action-form="approve">
                                                        {{ csrf() }}
                                                        {{ f.hidden('status', 'approved') }}
                                                        {{ f.hidden('checked', 'on') }}
                                                        <button type="submit"
                                                                class="btn btn-success btn-sm"
                                                                data-action="approve"
                                                                data-user-id="{{ userCert.id }}"
                                                                data-cert-id="{{ userCert.pivot.id }}"
                                                                data-user-name="{{ userCert.name|e }}"
                                                                title="{{ __('certifications.restore') }}">
                                                            {{ m.icon('arrow-clockwise') }} Restore
                                                        </button>
                                                    </form>
                                                {% endif %}

                                                <form method="post" action="{{ url('/admin/user/' ~ userCert.id ~ '/certifications/' ~ userCert.pivot.id ~ '/delete') }}" class="d-inline">
                                                    {{ csrf() }}
                                                    {{ f.hidden('checked', 'on') }}
                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm"
                                                            title="{{ __('certifications.remove') }}"
                                                            onclick="return confirm('{{ __('certifications.remove.confirm', [userCert.name|e]) }}')">>
                                                        {{ m.icon('trash') }}
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div class="mb-4">
                        {% set emptyStateIcons = {
                            'approved': 'people',
                            'self_confirmed': 'person-check',
                            'pending': 'hourglass-split',
                            'revoked': 'person-x',
                            'expired': 'calendar-x'
                        } %}
                        {% set emptyStateColors = {
                            'approved': 'text-success',
                            'self_confirmed': 'text-info',
                            'pending': 'text-warning',
                            'revoked': 'text-danger',
                            'expired': 'text-secondary'
                        } %}
                        {{ m.icon(emptyStateIcons[status], 48, emptyStateColors[status]) }}
                    </div>
                    <h5 class="text-muted mb-3">
                        {{ __('certifications.no_critters_with_status', {'status': __(('certifications.status.' ~ status))}) }}
                    </h5>
                    {% if status == 'pending' %}
                        <p class="text-muted mb-0">
                            {{ m.icon('info-circle') }}
                            New certification requests will appear here for approval.
                        </p>
                    {% elseif status == 'approved' %}
                        <p class="text-muted mb-0">
                            {{ m.icon('info-circle') }}
                            Approved critters will be listed here once certifications are granted.
                        </p>
                    {% elseif status == 'self_confirmed' %}
                        <p class="text-muted mb-0">
                            {{ m.icon('info-circle') }}
                            Self-confirmed certifications will appear here when users validate their own skills.
                        </p>
                    {% elseif status == 'revoked' %}
                        <p class="text-muted mb-0">
                            {{ m.icon('info-circle') }}
                            Revoked certifications are moved here for record-keeping.
                        </p>
                    {% elseif status == 'expired' %}
                        <p class="text-muted mb-0">
                            {{ m.icon('info-circle') }}
                            Expired certifications will appear here when they reach their end date.
                        </p>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% block scripts %}
{{ parent() }}
<script src="{{ asset('assets/certifications.js') }}"></script>
{% endblock %}
