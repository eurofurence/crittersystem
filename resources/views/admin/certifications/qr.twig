<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="msapplication-TileColor" content="#0d6efd">
    <meta name="theme-color" content="#0d6efd">

    <!-- Certification QR Configuration -->
    <meta name="digital-id:refresh-interval" content="{{ refreshInterval }}">
    <meta name="digital-id:verification-url" content="{{ verificationUrl|raw }}">
    <meta name="digital-id:refresh-endpoint" content="{{ url('/admin/certifications/' ~ certification.uuid ~ '/qr/refresh') }}">
    <meta name="digital-id:token" content="{{ token.token }}">
    <meta name="digital-id:page-type" content="certification">
    <meta name="csrf-token" content="{{ csrf_token() }}">

    <title>Certification QR Code - {{ certification.title }} - Critter System</title>

    <link rel="stylesheet" type="text/css" href="{{ url('assets/special/bootstrap/css/bootstrap.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ url('assets/special/bootstrap-icons/font/bootstrap-icons.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/digital-id-css.css') }}">
</head>

<body class="bg-light">
    <div class="container-fluid p-0">
        <!-- Header with return button -->
        <div class="bg-warning text-dark p-3 d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0">
                <i class="bi bi-qr-code me-2"></i>Certification QR Code
            </h1>
            <a href="{{ url('/admin/certifications/' ~ certification.uuid) }}" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Certification
            </a>
        </div>

        <!-- Certification Information -->
        <div class="container mt-3">
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-info">
                        <h5 class="alert-heading">
                            <i class="bi bi-info-circle"></i> {{ certification.title }}
                        </h5>
                        <p class="mb-2">{{ certification.description }}</p>
                        <hr>
                        <p class="mb-0">
                            <small class="text-muted">
                                <strong>Instructions:</strong> Users who have applied for this certification can scan this QR code to confirm their attendance and get their certification approved.
                            </small>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main certification QR card -->
        <div class="digital-id-card mx-auto mt-4">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-4">

                    <!-- Certification Information -->
                    <div class="certification-info mb-4">
                        <h2 class="display-6 fw-bold text-warning mb-2">{{ certification.title }}</h2>
                        <span class="badge bg-warning text-dark fs-6 mt-2">
                            <i class="bi bi-award"></i> CERTIFICATION CONFIRMATION
                        </span>
                    </div>

                    <!-- QR Code Display Area -->
                    <div class="qr-code-container mb-4">
                        <div id="qr-code-display" class="qr-code-display mx-auto" style="height: 300px">
                            <div id="qr-code-placeholder" class="d-flex justify-content-center align-items-center bg-light rounded" style="height: 250px;">
                                <div class="spinner-border text-warning" role="status">
                                    <span class="visually-hidden">Loading QR Code...</span>
                                </div>
                            </div>
                        </div>

                        <!-- QR Code Info -->
                        <div class="qr-info mt-3">
                            <small class="text-muted d-block">
                                <i class="bi bi-clock"></i> Auto-refresh every <span id="refresh-interval">{{ refreshInterval }}</span> seconds
                            </small>
                            <small class="text-muted d-block">
                                <i class="bi bi-shield-lock"></i> For certification confirmation only
                            </small>
                            <small class="text-muted d-block">
                                <i class="bi bi-exclamation-triangle"></i> Only for users who have applied for this certification
                            </small>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        <button type="button" id="refresh-btn" class="btn btn-outline-warning btn-lg me-2">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <!-- Status Messages -->
                    <div id="status-messages" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4 mb-3">
            <small class="text-muted">
                Certification QR System - Critter System
                <br>
                Last updated: <span id="last-updated">{{ "now"|date("H:i:s") }}</span>
            </small>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="{{ url('assets/special/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('assets/digitalid.js') }}"></script>
</body>
</html>