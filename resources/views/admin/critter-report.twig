{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="col-md-12">
        <h1>{{ block('title') }} <small>({{ users|length }})</small></h1>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <a href="{{ url('/admin/critter-report', {'format': 'csv'}) }}" class="btn btn-primary">
                        {{ m.icon('download') }} {{ __('Download CSV') }}
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{{ __('Username') }}</th>
                                <th>{{ __('User ID') }}</th>
                                <th>{{ __('OAuth User ID') }}</th>
                                <th>{{ __('Email') }}</th>
                                <th>{{ __('Badge Number') }}</th>
                                <th>{{ __('Is Staff') }}</th>
                                <th>{{ __('Total Shifts') }}</th>
                                <th>{{ __('Length (Hours)') }}</th>
                                <th>{{ __('Goodie Score (Minutes)') }}</th>
                                <th>{{ __('Goodie Score (Hours)') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>{{ user.username }}</td>
                                    <td>{{ user.user_id }}</td>
                                    <td>{{ user.oauth_user_id }}</td>
                                    <td>{{ user.email }}</td>
                                    <td>{{ user.badge_number }}</td>
                                    <td>
                                        {% if user.is_staff %}
                                            <span class="badge bg-success">{{ __('Yes') }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ __('No') }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ user.shift_count }}</td>
                                    <td>{{ user.work_time_hours|number_format(2) }}</td>
                                    <td>{{ user.goodie_score_minutes }}</td>
                                    <td>{{ user.goodie_score_hours|number_format(2) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if users|length == 0 %}
                    <div class="alert alert-info">
                        {{ __('No critters found.') }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}