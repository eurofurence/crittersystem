                {# Comprehensive Certification Catalog #}
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">{{ __('user_certifications.certification_catalog') }}</h5>
                        <small class="text-muted">
                            {{ availableCertifications|length }} {{ __('user_certifications.certifications_available') }}
                        </small>
                    </div>

                    {% if availableCertifications|length > 0 %}
                        <div class="list-group list-group-flush" id="certification-catalog"
                             role="region"
                             aria-label="{{ __('user_certifications.certification_list') }}"
                             aria-live="polite"
                             aria-relevant="additions removals">
                            {% for certification in availableCertifications %}
                                {% if certification.is_active %}
                                    {# Find user's status for this certification #}
                                    {% set user_certification = null %}
                                    {% set user_status = 'not_applied' %}
                                    {% set is_expired = false %}
                                    {% set is_expiring_soon = false %}

                                    {% for user_cert in certifications %}
                                        {% if user_cert.id == certification.id %}
                                            {% set user_certification = user_cert.pivot %}
                                            {% set user_status = user_cert.pivot.status %}

                                            {# Check expiry status #}
                                            {% if user_cert.pivot.date_expires %}
                                                {% set expire_date = user_cert.pivot.date_expires|date('Y-m-d') %}
                                                {% set current_date = 'now'|date('Y-m-d') %}
                                                {% set thirty_days_from_now = '+30 days'|date('Y-m-d') %}
                                                {% if expire_date < current_date %}
                                                    {% set is_expired = true %}
                                                    {% set user_status = 'expired' %}
                                                {% elseif expire_date < thirty_days_from_now %}
                                                    {% set is_expiring_soon = true %}
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}

                                    {# Use the certification card component #}
                                    {% include 'components/certification-card.twig' with {
                                        'certification': certification,
                                        'user_certification': user_certification,
                                        'user_status': user_status,
                                        'is_expired': is_expired,
                                        'is_expiring_soon': is_expiring_soon,
                                        'show_actions': true
                                    } %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="card-body text-center py-5">
                            <div class="text-muted">
                                {{ m.icon('award', 'display-6 mb-3') }}
                                <h5>{{ __('user_certifications.no_certifications_available') }}</h5>
                                <p>{{ __('user_certifications.no_certifications_available_description') }}</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="{{ asset('assets/certifications.js') }}"></script>
{% endblock %}
