        {# Certification Overview Dashboard #}
        {% set active_count = 0 %}
        {% set pending_count = 0 %}
        {% set self_confirmed_count = 0 %}
        {% set expired_count = 0 %}
        {% set total_user_certifications = certifications|length %}
        {% set expiring_count = 0 %}
        {% set available_count = 0 %}
        {% set self_confirmable_count = 0 %}

        {# Count user certifications by status #}
        {% for certification in certifications %}
            {% set status = certification.pivot.status %}
            {% if status == 'approved' %}
                {% set active_count = active_count + 1 %}
            {% elseif status == 'pending' %}
                {% set pending_count = pending_count + 1 %}
            {% elseif status == 'self_confirmed' %}
                {% set self_confirmed_count = self_confirmed_count + 1 %}
            {% endif %}

            {% if certification.pivot.date_expires %}
                {% set expire_date = certification.pivot.date_expires|date('Y-m-d') %}
                {% set current_date = 'now'|date('Y-m-d') %}
                {% set thirty_days_from_now = '+30 days'|date('Y-m-d') %}
                {% if expire_date < current_date %}
                    {% set expired_count = expired_count + 1 %}
                {% elseif expire_date < thirty_days_from_now %}
                    {% set expiring_count = expiring_count + 1 %}
                {% endif %}
            {% endif %}
        {% endfor %}

        {# Count available certifications #}
        {% for certification in availableCertifications %}
            {% if certification.is_active %}
                {% set available_count = available_count + 1 %}
                {% if certification.allow_self_confirmation %}
                    {% set self_confirmable_count = self_confirmable_count + 1 %}
                {% endif %}
            {% endif %}
        {% endfor %}

