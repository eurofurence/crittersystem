{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% set title = __('user_certifications.my_certifications') %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="container">
        {# Header #}
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1>
                    {{ m.icon('award') }}
                    {{ title }}
                </h1>
                <p class="text-muted">{{ __('user_certifications.user.description') }}</p>
            </div>

            <div class="dropdown">
                <button class="btn btn-dark btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    {{ m.icon('three-dots') }}
                    {{ __('form.actions') }}
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="#" data-action="print-certifications">
                            {{ m.icon('printer') }}
                            {{ __('user_certifications.print') }}
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="{{ url('/user/certifications/export') }}">
                            {{ m.icon('download') }}
                            {{ __('user_certifications.export') }}
                        </a>
                    </li>
                    {% if can('certification.help') %}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="{{ url('/help/certifications') }}">
                                {{ m.icon('question-circle') }}
                                {{ __('user_certifications.help') }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>

        {% include 'layouts/parts/messages.twig' %}

        {# My Applications Section #}
        {% if pendingApplications|length > 0 %}
            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex align-items-center justify-content-between">
                        <h5 class="card-title mb-0">
                            {{ m.icon('clock') }}
                            {{ __('user_certifications.my_applications') }}
                            <span class="badge bg-warning-subtle text-warning ms-2">{{ pendingApplications|length }}</span>
                        </h5>
                        <small class="text-muted">{{ __('user_certifications.applications_pending_review') }}</small>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        {% for application in pendingApplications %}
                            <div class="col-lg-6">
                                <div class="card border-warning bg-warning-subtle">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-start justify-content-between">
                                            <div class="flex-grow-1">
                                                <h6 class="card-title mb-2">
                                                    {{ application.certification.title }}
                                                </h6>
                                                {% if application.certification.description %}
                                                    <p class="card-text small text-muted mb-2">
                                                        {{ application.certification.description|u.truncate(100) }}
                                                    </p>
                                                {% endif %}
                                                <div class="small">
                                                    <div class="mb-1">
                                                        <strong>{{ __('user_certifications.applied_on') }}:</strong>
                                                        {{ application.created_at|date('M d, Y') }}
                                                    </div>
                                                    <div class="mb-1">
                                                        <strong>{{ __('user_certifications.status') }}:</strong>
                                                        <span class="badge bg-warning">
                                                            {{ m.icon('clock') }}
                                                            {{ __('user_certifications.status.pending') }}
                                                        </span>
                                                    </div>
                                                    {% if application.certification.contact_person %}
                                                        <div class="mb-1">
                                                            <strong>{{ __('user_certifications.contact') }}:</strong>
                                                            {{ application.certification.contact_person }}
                                                            {% if application.certification.contact_email %}
                                                                <a href="mailto:{{ application.certification.contact_email }}" class="text-decoration-none ms-1">
                                                                    {{ m.icon('envelope', 'small') }}
                                                                </a>
                                                            {% endif %}
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="ms-2">
                                                {% if application.certification.allow_self_confirmation %}
                                                    <a href="{{ url('/user/certifications/self-confirm/' ~ application.certification.uuid) }}"
                                                       class="btn btn-success btn-sm mb-1"
                                                       title="{{ __('user_certifications.self_confirm_tooltip') }}">
                                                        {{ m.icon('check-circle') }}
                                                        {{ __('user_certifications.self_confirm') }}
                                                    </a>
                                                {% endif %}
                                                <button type="button"
                                                        class="btn btn-secondary btn-sm withdraw-application-btn"
                                                        data-certification-uuid="{{ application.certification.uuid }}"
                                                        data-certification-title="{{ application.certification.title }}"
                                                        title="{{ __('user_certifications.withdraw_application_tooltip') }}">
                                                    {{ m.icon('x-circle') }}
                                                    {{ __('user_certifications.withdraw') }}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="mt-3">
                        <div class="alert alert-info d-flex align-items-center mb-0">
                            {{ m.icon('info-circle', 'me-2') }}
                            <div>
                                <strong>{{ __('user_certifications.applications_info_title') }}:</strong>
                                {{ __('user_certifications.applications_info_description') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

