{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ __('backstage.goodies.categories.title') }}{% endblock %}

{% block content %}
    <div class="container">
        <h1>
            {{ m.icon('grid-3x3-gap') }}
            {{ block('title') }}
            {% if can_edit %}
                {{ m.add(url('/admin/backstage/goodies/categories/create'), __('backstage.goodies.categories.create.title')) }}
            {% endif %}
        </h1>

        {% include 'layouts/parts/messages.twig' %}

        <div class="row mb-4">
            <div class="col-12">
                <div class="btn-toolbar justify-content-between" role="toolbar">
                    <div class="btn-group" role="group">
                        <a href="{{ url('/admin/backstage') }}" class="btn btn-secondary btn-sm">
                            {{ m.icon('arrow-left') }}
                            {{ __('backstage.back_to_dashboard') }}
                        </a>
                        <a href="{{ url('/admin/backstage/goodies/items') }}" class="btn btn-primary btn-sm">
                            {{ m.icon('box') }}
                            {{ __('backstage.goodies.items.title') }}
                        </a>
                    </div>
                    {% if can_edit %}
                        <div class="btn-group" role="group">
                            <a href="{{ url('/admin/backstage/goodies/categories/create') }}" class="btn btn-primary btn-sm">
                                {{ m.icon('plus-circle') }}
                                {{ __('backstage.goodies.categories.create.title') }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                {% if categories|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>{{ __('backstage.goodies.categories.name') }}</th>
                                    <th>{{ __('backstage.goodies.categories.description') }}</th>
                                    <th>{{ __('backstage.goodies.categories.items_count') }}</th>
                                    <th>{{ __('backstage.goodies.categories.status') }}</th>
                                    <th>{{ __('backstage.goodies.categories.order') }}</th>
                                    <th class="text-end">{{ __('form.actions') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for category in categories %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                {% if category.is_active %}
                                                    <span class="badge bg-success me-2">{{ m.icon('check-circle') }}</span>
                                                {% else %}
                                                    <span class="badge bg-secondary me-2">{{ m.icon('x-circle') }}</span>
                                                {% endif %}
                                                <div>
                                                    <a href="{{ url('/admin/backstage/goodies/categories/' ~ category.uuid) }}"
                                                       class="fw-bold text-decoration-none">
                                                        {{ category.name }}
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            {% if category.description %}
                                                <span class="text-muted">
                                                    {{ category.description|length > 50 ? category.description|slice(0, 50) ~ '...' : category.description }}
                                                </span>
                                            {% else %}
                                                <span class="text-muted fst-italic">{{ __('form.no_description') }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-info">
                                                {{ category.items_count|default(0) }}
                                                {{ __('backstage.goodies.categories.items') }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if category.is_active %}
                                                <span class="badge bg-success">{{ __('backstage.goodies.status.active') }}</span>
                                            {% else %}
                                                <span class="badge bg-danger">{{ __('backstage.goodies.status.inactive') }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">{{ category.display_order|default(0) }}</span>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{{ url('/admin/backstage/goodies/categories/' ~ category.uuid) }}"
                                                   class="btn btn-sm btn-info"
                                                   title="{{ __('form.view') }}">
                                                    {{ m.icon('eye') }}
                                                </a>

                                                {% if can_edit %}
                                                    <a href="{{ url('/admin/backstage/goodies/categories/' ~ category.uuid ~ '/edit') }}"
                                                       class="btn btn-secondary btn-sm"
                                                       title="{{ __('form.edit') }}">
                                                        {{ m.icon('pencil') }}
                                                    </a>

                                                    <div class="btn-group" role="group">
                                                        <button type="button"
                                                                class="btn btn-danger btn-sm dropdown-toggle"
                                                                data-bs-toggle="dropdown"
                                                                title="{{ __('backstage.goodies.categories.more_actions') }}">
                                                            {{ m.icon('three-dots-vertical') }}
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            <li>
                                                                <form method="post"
                                                                      action="{{ url('/admin/backstage/goodies/categories/' ~ category.uuid ~ '/delete') }}"
                                                                      class="d-inline w-100">
                                                                    {{ csrf() }}
                                                                    <button type="submit"
                                                                            class="dropdown-item text-danger"
                                                                            data-confirm="{{ __('backstage.goodies.categories.delete.confirm', [category.name|e]) }}">
                                                                        {{ m.icon('trash') }}
                                                                        {{ __('form.delete') }}
                                                                    </button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <div class="mb-3">
                            {{ m.icon('grid-3x3-gap', 64) }}
                        </div>
                        <h4 class="text-muted">{{ __('backstage.goodies.categories.empty.title') }}</h4>
                        <p class="text-muted">
                            {{ __('backstage.goodies.categories.empty.message') }}
                        </p>
                        {% if can_edit %}
                            <a href="{{ url('/admin/backstage/goodies/categories/create') }}" class="btn btn-primary">
                                {{ m.icon('plus-circle') }}
                                {{ __('backstage.goodies.categories.create.first') }}
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="{{ asset('assets/goodies-items.js') }}"></script>
{% endblock %}
