{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ __('backstage.users.goodies.title') }} - {{ target_user.name }}{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                {# Header with navigation #}
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>
                        {{ m.icon('gift') }}
                        {{ block('title') }}
                    </h1>
                    <div class="btn-toolbar" role="toolbar">
                        <div class="btn-group" role="group">
                            <a href="{{ url('/admin/backstage/users/search') }}" class="btn btn-secondary btn-sm">
                                {{ m.icon('arrow-left') }}
                                {{ __('backstage.users.back_to_search') }}
                            </a>
                            <a href="{{ url('/admin/backstage') }}" class="btn btn-outline-secondary btn-sm">
                                {{ m.icon('house') }}
                                {{ __('backstage.back_to_dashboard') }}
                            </a>
                        </div>
                    </div>
                </div>

                {% include 'layouts/parts/messages.twig' %}

                <div class="row">
                    {# User Information Section #}
                    <div class="col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    {{ m.icon('person-circle') }}
                                    {{ __('backstage.users.information') }}
                                </h5>
                            </div>
                            <div class="card-body">
                                {# User Basic Info #}
                                <div class="row text-center mb-3">
                                    <div class="col-6">
                                        <div class="border rounded p-2">
                                            <h6 class="text-muted mb-1">{{ __('backstage.users.id') }}</h6>
                                            <strong>{{ target_user.id }}</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="border rounded p-2">
                                            <h6 class="text-muted mb-1">{{ __('backstage.users.badge') }}</h6>
                                            <strong>{{ target_user.personalData.badge_number|default('N/A') }}</strong>
                                        </div>
                                    </div>
                                </div>

                                {# User Name #}
                                <div class="mb-3">
                                    <h4 class="mb-1">{{ target_user.name }}</h4>
                                    {% if target_user.personalData.first_name or target_user.personalData.last_name %}
                                        <p class="text-muted">
                                            {{ [target_user.personalData.first_name, target_user.personalData.last_name]|join(' ')|trim }}
                                        </p>
                                    {% endif %}
                                </div>

                                {# User Badges (Staff/Critter) #}
                                <div class="mb-3">
                                    {% for badge in user_badges %}
                                        <span class="badge {{ badge.class }} me-2">
                                            {{ badge.text }}
                                        </span>
                                    {% endfor %}
                                </div>

                                {# Arrival Status #}
                                <div class="mb-3">
                                    {% if target_user.state.arrived %}
                                        <span class="badge bg-success">
                                            {{ m.icon('check-circle') }}
                                            {{ __('backstage.users.status.arrived') }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">
                                            {{ m.icon('clock') }}
                                            {{ __('backstage.users.status.not_arrived') }}
                                        </span>
                                    {% endif %}
                                </div>

                                {# Registration Date #}
                                {% if target_user.created_at %}
                                    <small class="text-muted">
                                        {{ m.icon('calendar-plus') }}
                                        {{ __('backstage.users.registered') }}: {{ target_user.created_at|date('Y-m-d') }}
                                    </small>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Hours Calculation Section #}
                    <div class="col-lg-8 mb-4">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    {{ m.icon('clock-history') }}
                                    {{ __('backstage.users.hours.title') }}
                                </h5>
                            </div>
                            <div class="card-body">
                                {# Total Hours Display #}
                                <div class="row text-center mb-4">
                                    <div class="col-12">
                                        <div class="alert alert-info">
                                            <h2 class="mb-0">
                                                {{ hours_data.total_hours }}
                                                <small class="text-muted">{{ __('backstage.users.hours.total') }}</small>
                                            </h2>
                                        </div>
                                    </div>
                                </div>

                                {# Hours Breakdown #}
                                <div class="row text-center">
                                    <div class="col-md-3 col-6 mb-3">
                                        <div class="border rounded p-3">
                                            <h4 class="text-primary mb-1">{{ hours_data.day_shifts_hours }}</h4>
                                            <small class="text-muted">{{ __('backstage.users.hours.day_shifts') }}</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6 mb-3">
                                        <div class="border rounded p-3">
                                            <h4 class="text-warning mb-1">{{ hours_data.night_shifts_hours }}</h4>
                                            <small class="text-muted">{{ __('backstage.users.hours.night_shifts') }}</small>
                                            <br><small class="text-info">(+{{ hours_data.night_shifts_bonus }} bonus)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6 mb-3">
                                        <div class="border rounded p-3">
                                            <h4 class="text-success mb-1">{{ hours_data.worklog_hours }}</h4>
                                            <small class="text-muted">{{ __('backstage.users.hours.worklog') }}</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6 mb-3">
                                        <div class="border rounded p-3">
                                            <h4 class="text-danger mb-1">-{{ hours_data.freeload_penalty_hours }}</h4>
                                            <small class="text-muted">{{ __('backstage.users.hours.freeload_penalty') }}</small>
                                        </div>
                                    </div>
                                </div>

                                {# Shifts Summary #}
                                <div class="row text-center mt-3">
                                    <div class="col-4">
                                        <small class="text-muted">{{ __('backstage.users.shifts.completed') }}</small>
                                        <br><strong>{{ hours_data.completed_shifts_count }}</strong>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">{{ __('backstage.users.shifts.night') }}</small>
                                        <br><strong>{{ hours_data.night_shifts_count }}</strong>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">{{ __('backstage.users.shifts.freeload') }}</small>
                                        <br><strong>{{ hours_data.freeload_shifts_count }}</strong>
                                    </div>
                                </div>

                                <small class="text-muted mt-2 d-block">
                                    {{ __('backstage.users.hours.calculated_at') }}: {{ hours_data.calculation_timestamp|date('H:i:s') }}
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                {# Group 1: Qualified Goodies (Can claim now) #}
                {% if categorized_goodies.qualified|length > 0 %}
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    {{ m.icon('check-circle') }}
                                    {{ __('backstage.goodies.qualified_items') }} ({{ categorized_goodies.qualified|length }})
                                </h5>
                                <small>{{ __('backstage.goodies.qualified_description') }}</small>
                            </div>
                            <div class="card-body">
                                {% if can_distribute %}
                                <form method="post" action="{{ url('/admin/backstage/users/' ~ target_user.id ~ '/goodies/bulk-distribute') }}" id="bulk-distribute-form">
                                    {{ csrf() }}
                                    
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="select-all-qualified">
                                            <label class="form-check-label" for="select-all-qualified">
                                                {{ __('backstage.goodies.select_all') }}
                                            </label>
                                        </div>
                                        <div>
                                            <button type="submit" class="btn btn-success">
                                                {{ m.icon('gift') }}
                                                {{ __('backstage.goodies.distribute_selected') }}
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th width="50">{{ __('backstage.goodies.select') }}</th>
                                                    <th>{{ __('backstage.goodies.item') }}</th>
                                                    <th width="120">{{ __('backstage.goodies.required_hours') }}</th>
                                                    <th width="120">{{ __('backstage.goodies.category') }}</th>
                                                    <th width="100">{{ __('backstage.goodies.quantity') }}</th>
                                                    <th width="120">{{ __('backstage.goodies.individual') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for goodie_data in categorized_goodies.qualified %}
                                                    {% set goodie = goodie_data.goodie %}
                                                    <tr>
                                                        <td>
                                                            <input class="form-check-input bulk-item-checkbox" 
                                                                   type="checkbox" 
                                                                   name="selected_items[]" 
                                                                   value="{{ goodie.id }}">
                                                        </td>
                                                        <td>
                                                            <strong>{{ goodie.name }}</strong>
                                                            {% if goodie.description %}
                                                                <br><small class="text-muted">{{ goodie.description }}</small>
                                                            {% endif %}
                                                            {% if goodie.max_per_person %}
                                                                <br><small class="text-info">{{ __('backstage.goodies.max_per_person') }}: {{ goodie.max_per_person }}</small>
                                                            {% endif %}
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-primary">{{ goodie.required_hours }}h</span>
                                                        </td>
                                                        <td>
                                                            {% if goodie.category %}
                                                                <span class="badge bg-info">{{ goodie.category.name }}</span>
                                                            {% else %}
                                                                <span class="text-muted">-</span>
                                                            {% endif %}
                                                        </td>
                                                        <td>
                                                            <input type="number" 
                                                                   name="quantities[{{ goodie.id }}]" 
                                                                   class="form-control form-control-sm" 
                                                                   value="{{ goodie_data.pre_filled_quantity }}" 
                                                                   min="1" 
                                                                   {% if goodie.max_per_person %}max="{{ goodie.max_per_person }}"{% endif %}>
                                                        </td>
                                                        <td>
                                                            <form method="post" action="{{ url('/admin/backstage/users/' ~ target_user.id ~ '/goodies/distribute') }}" class="d-inline">
                                                                {{ csrf() }}
                                                                <input type="hidden" name="goodie_id" value="{{ goodie.id }}">
                                                                <input type="hidden" name="quantity" value="1">
                                                                <button type="submit" class="btn btn-outline-success btn-sm" title="{{ __('backstage.goodies.distribute_one') }}">
                                                                    {{ m.icon('plus-circle') }}
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <label for="global_notes" class="form-label">{{ __('backstage.goodies.global_notes') }}</label>
                                            <input type="text" name="global_notes" id="global_notes" class="form-control" 
                                                   placeholder="{{ __('backstage.goodies.notes_optional') }}">
                                        </div>
                                    </div>
                                </form>
                                {% else %}
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>{{ __('backstage.goodies.item') }}</th>
                                                <th>{{ __('backstage.goodies.required_hours') }}</th>
                                                <th>{{ __('backstage.goodies.category') }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for goodie_data in categorized_goodies.qualified %}
                                                {% set goodie = goodie_data.goodie %}
                                                <tr>
                                                    <td>
                                                        <strong>{{ goodie.name }}</strong>
                                                        {% if goodie.description %}
                                                            <br><small class="text-muted">{{ goodie.description }}</small>
                                                        {% endif %}
                                                    </td>
                                                    <td><span class="badge bg-primary">{{ goodie.required_hours }}h</span></td>
                                                    <td>
                                                        {% if goodie.category %}
                                                            <span class="badge bg-info">{{ goodie.category.name }}</span>
                                                        {% else %}
                                                            <span class="text-muted">-</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                {# Group 2: Next Items to Claim (Need more hours) #}
                {% if categorized_goodies.next_to_claim|length > 0 %}
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-warning">
                            <div class="card-header bg-warning text-dark">
                                <h5 class="mb-0">
                                    {{ m.icon('clock-history') }}
                                    {{ __('backstage.goodies.next_to_claim') }} ({{ categorized_goodies.next_to_claim|length }})
                                </h5>
                                <small>{{ __('backstage.goodies.next_to_claim_description') }}</small>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>{{ __('backstage.goodies.item') }}</th>
                                                <th width="120">{{ __('backstage.goodies.required_hours') }}</th>
                                                <th width="120">{{ __('backstage.goodies.hours_gap') }}</th>
                                                <th width="200">{{ __('backstage.goodies.progress') }}</th>
                                                <th width="120">{{ __('backstage.goodies.category') }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for goodie_data in categorized_goodies.next_to_claim %}
                                                {% set goodie = goodie_data.goodie %}
                                                {% set progress_percentage = ((hours_data.total_hours / goodie.required_hours) * 100)|round %}
                                                <tr>
                                                    <td>
                                                        <strong>{{ goodie.name }}</strong>
                                                        {% if goodie.description %}
                                                            <br><small class="text-muted">{{ goodie.description }}</small>
                                                        {% endif %}
                                                    </td>
                                                    <td><span class="badge bg-primary">{{ goodie.required_hours }}h</span></td>
                                                    <td><span class="badge bg-warning">{{ goodie_data.hours_gap }}h</span></td>
                                                    <td>
                                                        <div class="progress" style="height: 20px;">
                                                            <div class="progress-bar" role="progressbar" 
                                                                 style="width: {{ progress_percentage }}%;" 
                                                                 aria-valuenow="{{ progress_percentage }}" 
                                                                 aria-valuemin="0" aria-valuemax="100">
                                                                {{ progress_percentage }}%
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        {% if goodie.category %}
                                                            <span class="badge bg-info">{{ goodie.category.name }}</span>
                                                        {% else %}
                                                            <span class="text-muted">-</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                {# Group 3: Already Claimed Items #}
                {% if categorized_goodies.already_claimed|length > 0 %}
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-info">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0">
                                    {{ m.icon('check-square') }}
                                    {{ __('backstage.goodies.already_claimed') }} ({{ categorized_goodies.already_claimed|length }})
                                </h5>
                                <small>{{ __('backstage.goodies.already_claimed_description') }}</small>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>{{ __('backstage.goodies.item') }}</th>
                                                <th width="100">{{ __('backstage.goodies.quantity_claimed') }}</th>
                                                <th width="150">{{ __('backstage.goodies.last_distributed') }}</th>
                                                <th>{{ __('backstage.goodies.summary') }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for goodie_data in categorized_goodies.already_claimed %}
                                                {% set goodie = goodie_data.goodie %}
                                                {% set distribution_summary = goodie_data.distribution_summary %}
                                                <tr>
                                                    <td>
                                                        <strong>{{ goodie.name }}</strong>
                                                        {% if goodie.description %}
                                                            <br><small class="text-muted">{{ goodie.description }}</small>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-success">{{ distribution_summary.total_delivered }}</span>
                                                    </td>
                                                    <td>
                                                        {% if distribution_summary.last_delivered_at %}
                                                            <small>{{ distribution_summary.last_delivered_at|date('M j, H:i') }}</small>
                                                        {% else %}
                                                            <span class="text-muted">-</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <small class="text-success">
                                                            {{ distribution_summary.display_text }}
                                                        </small>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                {# No Goodies Available Message #}
                {% if categorized_goodies.qualified|length == 0 and categorized_goodies.next_to_claim|length == 0 and categorized_goodies.already_claimed|length == 0 %}
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body text-center py-5">
                                <div class="mb-3">
                                    {{ m.icon('gift', 64) }}
                                </div>
                                <h4 class="text-muted">{{ __('backstage.goodies.no_goodies_available') }}</h4>
                                <p class="text-muted">{{ __('backstage.goodies.no_goodies_message') }}</p>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                {# Distribution History Section #}
                {% if distribution_history|length > 0 %}
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        {{ m.icon('journal-text') }}
                                        {{ __('backstage.users.goodies.history') }}
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>{{ __('backstage.goodies.item') }}</th>
                                                    <th>{{ __('backstage.goodies.quantity') }}</th>
                                                    <th>{{ __('backstage.goodies.distributed_by') }}</th>
                                                    <th>{{ __('backstage.goodies.distributed_at') }}</th>
                                                    <th>{{ __('backstage.goodies.notes') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for distribution in distribution_history %}
                                                    <tr>
                                                        <td>{{ distribution.item_name }}</td>
                                                        <td><span class="badge bg-primary">{{ distribution.quantity }}</span></td>
                                                        <td>{{ distribution.distributed_by }}</td>
                                                        <td>{{ distribution.distributed_at|date('M j, H:i') }}</td>
                                                        <td>
                                                            {% if distribution.notes %}
                                                                {{ distribution.notes }}
                                                            {% else %}
                                                                <em class="text-muted">{{ __('backstage.goodies.no_notes') }}</em>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Custom styles for goodies profile page - Optimized table layout */
.card {
    box-shadow: 0 2px 4px rgba(0,0,0,.1);
}

.card-header {
    background-color: var(--bs-light);
    border-bottom: 1px solid var(--bs-border-color);
}

.alert-info h2 {
    color: inherit;
}

/* Group-specific styling */
.border-success {
    border-color: var(--bs-success) !important;
    border-width: 2px !important;
}

.border-warning {
    border-color: var(--bs-warning) !important;
    border-width: 2px !important;
}

.border-info {
    border-color: var(--bs-info) !important;
    border-width: 2px !important;
}

/* Table enhancements */
.table-hover tbody tr:hover {
    background-color: rgba(0,0,0,.04);
}

.table th {
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid var(--bs-border-color);
}

.table td {
    vertical-align: middle;
    padding: 0.75rem 0.5rem;
}

/* Form enhancements */
.form-control-sm {
    font-size: 0.875rem;
}

input[type="number"].form-control-sm {
    width: 80px;
    text-align: center;
}

/* Checkbox styling */
.form-check-input {
    width: 1.1em;
    height: 1.1em;
}

.bulk-item-checkbox {
    cursor: pointer;
}

/* Progress bar enhancements */
.progress {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
}

.progress-bar {
    font-size: 0.75rem;
    font-weight: 600;
}

/* Badge styling improvements */
.badge {
    font-size: 0.75rem;
    font-weight: 600;
}

/* Button improvements */
.btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
}

/* Card header styling */
.bg-success {
    background-color: var(--bs-success) !important;
}

.bg-warning {
    background-color: var(--bs-warning) !important;
}

.bg-info {
    background-color: var(--bs-info) !important;
}

/* Responsive table improvements */
@media (max-width: 768px) {
    .table-responsive table {
        font-size: 0.875rem;
    }
    
    .table td, .table th {
        padding: 0.5rem 0.25rem;
    }
    
    input[type="number"].form-control-sm {
        width: 60px;
    }
    
    .btn-sm {
        padding: 0.125rem 0.25rem;
        font-size: 0.7rem;
    }
}

@media (max-width: 576px) {
    .d-flex.justify-content-between {
        flex-direction: column;
        gap: 1rem;
    }
    
    .d-flex.justify-content-between > div {
        text-align: center;
    }
}

/* Print styles */
@media print {
    .btn, .card-footer, .form-check, .col-12:last-child .row {
        display: none !important;
    }
    
    .card {
        box-shadow: none;
        border: 1px solid #000;
        break-inside: avoid;
        margin-bottom: 1rem;
    }
    
    .card-header {
        background-color: #f8f9fa !important;
        color: #000 !important;
    }
    
    .table {
        font-size: 0.8rem;
    }
    
    .progress {
        border: 1px solid #000;
    }
    
    .badge {
        border: 1px solid #000;
        background-color: transparent !important;
        color: #000 !important;
    }
}

/* Focus and accessibility improvements */
.form-check-input:focus,
.form-control:focus,
.btn:focus {
    box-shadow: 0 0 0 0.2rem rgba(0,123,255,0.25);
}

/* Loading state styles (for future enhancement) */
.table tbody tr.loading {
    opacity: 0.6;
