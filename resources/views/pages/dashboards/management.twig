{% extends "layouts/app.twig" %}

{% block title %}{{ __('dashboard.management.title') }}{% endblock %}

{% block content %}
<h1>{{ __('dashboard.management.title') }}</h1>
<div class="row">
    <div class="col p-3">
        <form action="" method="get">
            <input class="form-control" id="dashboardSearchbox" name="query" placeholder="Filter...">
        </form>
    </div>
    <div class="col p-3">
        <div>TODO: [Start date] [Number of days] [Other things]</div><br>
    </div>
</div>
<div class="row">
    <div class="col table-responsive">
        <table class="table table-striped table-hover">
            <colgroup>
                <col span="3" class="dash-compound-key" />
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>Room</th>
                    <th>Shift</th>
                    <th>Hand</th>
                    <th>Assistant</th>
                    <th>Man-Bear-Pig</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                <tr>
                    <th>10:00 - 12:00</th>
                    <td>Hall H (7-8)</td>
                    <td>Opening</td>
                    <td>IOOX</td>
                    <td>I</td>
                    <td>II</td>
                </tr>
                <tr>
                    <th>10:00 - 12:00</th>
                    <td>Hall H (7-8)</td>
                    <td>Opening</td>
                    <td>IOOX</td>
                    <td>I</td>
                    <td>II</td>
                </tr>
            </tbody>
            <tbody class="table-group-divider">
                <tr>
                    <th>11:00 - 12:00</th>
                    <td>Hall Z</td>
                    <td>Mystery Shift</td>
                    <td>IIXXXX</td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
            <tbody class="table-group-divider">
                <tr>
                    <th>13:00 - 15:00</th>
                    <td>Hall 3</td>
                    <td>Talk to a cat</td>
                    <td>O</td>
                    <td>O</td>
                    <td>O</td>
                </tr>
                <tr>
                    <th>13:00 - 15:00</th>
                    <td>Hall Z</td>
                    <td>Dance</td>
                    <td>OO</td>
                    <td>OOX</td>
                    <td>O</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <h2>Shitty debug area don't look please</h2>
    <h3>Shift Types</h3>
    <pre>
        {%- for shiftType in shiftTypes  -%}
            {{ shiftType }}
        {%~ endfor ~%}
    </pre>
    <h3>Shifts</h3>
    <pre>
        {%- for shift in shifts -%}
            {{ shift }}
        {%~ endfor ~%}
    </pre>
</div>

{% endblock %}
