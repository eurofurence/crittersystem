{% extends "layouts/app.twig" %}

{% block title %}{{ __('dashboard.management.title') }}{% endblock %}

{% block content %}
<h1>{{ __('dashboard.management.title') }}</h1>
<div class="row">
    <div class="col p-3">
        <form action="" method="get">
            <input class="form-control" id="dashboardSearchbox" name="query" placeholder="Filter...">
        </form>
    </div>
    <div class="col p-3">
        <div>TODO: [Start date] [Number of days] [Other things]</div><br>
    </div>
</div>
<div class="row">
    {% block dashboard_shifts_management %}
        <div class="col table-responsive">
            <table class="table table-striped table-hover">
                <colgroup>
                    <col span="3" class="dash-compound-key" />
                </colgroup>
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>Room</th>
                        <th>Shift</th>
                        {% for type in critter_types %}
                            <th>{{ type | e }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                {% block dashboard_shifts_management_body %}
                    {% set previous_start = -1 %}
                    {% for shift in shifts %}
                        {% for idx, shift_entry in shift %}
                            {% set new_start_time = (previous_start is not same as(shift_entry.shifts_start)) %}
                            {% if new_start_time %}
                                <tbody class="table-group-divider">
                            {% endif %}
                            {% if idx is same as(0) %}
                                <tr>
                                    <th>{{ shift_entry.shifts_start | date('H:i') }} - {{ shift_entry.shifts_end | date('H:i') }}</th>
                                    <td>{{ shift_entry.locations_name | e }}</td>
                                    <td>{{ shift_entry.shifts_title | e }}</td>
                            {% endif %}
                                <td>{{ shift_entry.needed_angel_types_count | e }}</td>
                            {% if idx is same as(0) %}
                                </tr>
                            {% endif %}
                            {% if new_start_time %}
                                </tbody>
                            {% endif %}
                            {% set previous_start = shift_entry.shifts_start %}
                        {% endfor %}
                    {% endfor %}
                {% endblock %}
            </table>
        </div>
    {% endblock %}
</div>

<div class="row">
    <h2>Awful debug area don't look please</h2>
    <h3>Critter Types</h3>
    <pre>
        {%- for type in critter_types -%}
            {{ type }}
        {%~ endfor ~%}
    </pre>
    <h3>Shifts</h3>
    <pre>
        {%- for shift in shifts -%}
            {{ shift }}
        {%~ endfor ~%}
    </pre>
</div>

{% endblock %}
