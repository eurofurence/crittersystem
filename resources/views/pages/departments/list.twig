{% extends "layouts/app.twig" %}

{% block title %}{{ __('Departments') }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h1>{{ __('Departments') }}</h1>
            </div>
            {% if can_create %}
                <div class="col-auto">
                    <a href="{{ url('/departments/create') }}" class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i> {{ __('Create Department') }}
                    </a>
                </div>
            {% endif %}
        </div>

        {% if departments.isEmpty() %}
            <div class="alert alert-info">
                {{ __('No departments available.') }}
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                {% for department in departments %}
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    {% if department.staff_only %}
                                        <i class="bi bi-shield-lock-fill text-muted" title="{{ __('Staff Only') }}"></i>
                                    {% endif %}
                                    {{ department.name }}
                                </h5>
                                {% if department.description %}
                                    <p class="card-text">{{ department.description }}</p>
                                {% endif %}
                            </div>
                            <div class="card-footer bg-transparent">
                                <div class="d-flex justify-content-between align-items-center">
                                    <a href="{{ url('/departments/' ~ department.uuid) }}" class="btn btn-sm btn-info">
                                        {{ __('View Details') }}
                                    </a>
                                    {% set userDept = user_departments.firstWhere('id', department.id) %}
                                    {% if userDept %}
                                        <span class="badge bg-{{ userDept.pivot.status == 'pending' ? 'warning' : 'success' }}">
                                            {{ __('department.badge.' ~ userDept.pivot.status) }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
