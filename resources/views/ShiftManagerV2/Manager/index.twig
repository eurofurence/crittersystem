{% extends "ShiftManagerV2/_layout.twig" %}

{% block smv2_content %}
  <h1 class="h3 mb-3">{{ __('Shift Manager — Manager View') }}</h1>
  
  {# Top Bar with filters #}
  {% include "ShiftManagerV2/partials/top_bar.twig" %}
  
  {# KPI cards #}
  {% include "ShiftManagerV2/partials/kpi_cards.twig" %}
  {# Timeline View (default for Manager) #}
  <div id="smv2-timeline" class="smv2-timeline" role="grid" aria-label="Shifts timeline">
    <div class="text-center text-muted p-4">
      <div class="spinner-border" role="status" aria-hidden="true"></div>
      <div class="mt-2">{{ __('Loading timeline...') }}</div>
    </div>
  </div>
  
  {# List View (hidden by default for Manager) #}
  <div id="smv2-list" class="smv2-list d-none" role="list" aria-label="Shifts list"></div>

  {# Manager Modal #}
  <div class="modal fade" id="smv2-modal" tabindex="-1" aria-labelledby="smv2ModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content bg-dark">
        <div class="modal-header">
          <h5 class="modal-title" id="smv2ModalLabel">Manage Shift</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <ul class="nav nav-tabs" id="smv2ModalTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="tab-assignments" data-bs-toggle="tab" data-bs-target="#pane-assignments" type="button" role="tab" aria-controls="pane-assignments" aria-selected="true">Assignments</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="tab-applications" data-bs-toggle="tab" data-bs-target="#pane-applications" type="button" role="tab" aria-controls="pane-applications" aria-selected="false">Applications</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="tab-notes" data-bs-toggle="tab" data-bs-target="#pane-notes" type="button" role="tab" aria-controls="pane-notes" aria-selected="false">Notes</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="tab-hours" data-bs-toggle="tab" data-bs-target="#pane-hours" type="button" role="tab" aria-controls="pane-hours" aria-selected="false">Hours & Audit</button>
            </li>
          </ul>
          <div class="tab-content pt-3" id="smv2ModalTabContent">
            <div class="tab-pane fade show active" id="pane-assignments" role="tabpanel" aria-labelledby="tab-assignments">
              <div id="smv2-assignments"></div>
              <hr>
              <h6>Add People</h6>
              <input id="smv2-assign-search" type="text" class="form-control mb-2" placeholder="Search by name…">
              <div id="smv2-assign-candidates" class="mb-2"></div>
              <div class="d-flex align-items-end mb-2">
                <div class="me-2">
                  <label class="form-label">Critter Type (AngelType) ID</label>
                  <input type="number" class="form-control" id="smv2-assign-angeltype" placeholder="e.g. 5">
                </div>
                <button id="smv2-assign-selected" class="btn btn-primary btn-sm ms-2">Add Selected</button>
              </div>
              <form id="smv2-assign-form" class="row g-2" autocomplete="off">
                <div class="col-md-5">
                  <label class="form-label">User ID(s) (comma-separated)</label>
                  <input type="text" class="form-control" id="smv2-assign-user-ids" placeholder="e.g. 12,34">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Critter Type (AngelType) ID</label>
                  <input type="number" class="form-control" id="smv2-assign-angeltype" placeholder="e.g. 5">
                </div>
                <div class="col-md-3 align-self-end">
                  <button type="submit" class="btn btn-primary w-100">Assign</button>
                </div>
              </form>
            </div>
            <div class="tab-pane fade" id="pane-applications" role="tabpanel" aria-labelledby="tab-applications">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h6>{{ __('Pending Applications') }}</h6>
                <button id="smv2-bulk-approve" class="btn btn-success btn-sm" disabled>
                  {{ __('Approve Selected') }}
                </button>
              </div>
              <div class="mb-2">
                <select class="form-select form-select-sm" id="smv2-filter-angel-type">
                  <option value="">{{ __('All Critter Types') }}</option>
                </select>
              </div>
              <div id="smv2-applications-list" class="text-muted">
                {{ __('Loading applications...') }}
              </div>
            </div>
            <div class="tab-pane fade" id="pane-notes" role="tabpanel" aria-labelledby="tab-notes">
              <div class="mb-2"><strong>Internal Comments</strong> (not exposed to Staff/Public) — TBD</div>
              <div><strong>Public Notes</strong> — TBD</div>
            </div>
            <div class="tab-pane fade" id="pane-hours" role="tabpanel" aria-labelledby="tab-hours">
              <form id="smv2-worklog-form" class="row g-2">
                <div class="col-md-5">
                  <label class="form-label">User ID</label>
                  <input type="number" class="form-control" id="smv2-worklog-user" placeholder="User ID">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Minutes</label>
                  <input type="number" class="form-control" id="smv2-worklog-mins" placeholder="e.g. 60">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Comment</label>
                  <input type="text" class="form-control" id="smv2-worklog-comment" placeholder="Optional comment">
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-primary">Add Worklog</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
