<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="msapplication-TileColor" content="#0d6efd">
    <meta name="theme-color" content="#0d6efd">

    <!-- Digital ID Configuration -->
    <meta name="digital-id:page-type" content="error">

    <title>Verification Error - Critter System</title>

    <link rel="stylesheet" type="text/css" href="{{ url('assets/special/bootstrap/css/bootstrap.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ url('assets/special/bootstrap-icons/font/bootstrap-icons.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/digital-id-css.css') }}">
</head>

<body class="bg-light">
    <div class="container-fluid p-0">
        <!-- Header -->
        <div class="bg-danger text-white p-3 text-center">
            <h1 class="h4 mb-0">
                <i class="bi bi-shield-x me-2"></i>Verification Failed
            </h1>
        </div>

        <!-- Error Card -->
        <div class="verification-card mx-auto mt-4">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-5">

                    <!-- Error Icon -->
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                    </div>

                    <!-- Error Message -->
                    <h2 class="h4 text-danger mb-3">{{ error }}</h2>
                    <p class="text-muted mb-4">{{ message }}</p>

                    <!-- Instructions -->
                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> {{ __('What to do:') }}</h6>
                        <ul class="list-unstyled mb-0 text-start">
                            <li class="mb-2">
                                <i class="bi bi-arrow-clockwise text-primary"></i>
                                {{ __('Ask the user to refresh their Critter ID') }}
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-qr-code text-primary"></i>
                                {{ __('Scan the QR code again') }}
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-person-check text-primary"></i>
                                {{ __('Use alternative verification if needed') }}
                            </li>
                        </ul>
                    </div>

                    <!-- Retry Button -->
                    <button type="button" id="retry-btn" class="btn btn-primary btn-lg me-2">
                        <i class="bi bi-arrow-clockwise"></i> Try Again
                    </button>

                    <button type="button" id="go-back-btn" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> Go Back
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4 mb-3">
            <small class="text-muted">
                Critter ID Verification System - Critter System
                <br>
                Error occurred at: {{ "now"|date("H:i:s d.m.Y") }}
            </small>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="{{ url('assets/special/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('assets/digitalid.js') }}"></script>
</body>
</html>
