<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="msapplication-TileColor" content="#0d6efd">
    <meta name="theme-color" content="#0d6efd">

    <title>Digital ID Verification - Critter System</title>

    <link rel="stylesheet" type="text/css" href="{{ url('assets/special/bootstrap/css/bootstrap.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ url('assets/special/bootstrap-icons/font/bootstrap-icons.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/digital-id-css.css') }}">
</head>

<body class="bg-light">
    <div class="container-fluid p-0">
        <!-- Header -->
        <div class="bg-success text-white p-3 text-center">
            <h1 class="h4 mb-0">
                <i class="bi bi-shield-check me-2"></i>Identity Verified
            </h1>
            <small class="opacity-75">Verified at {{ verifiedAt.format('H:i:s') }}</small>
        </div>

        <!-- User Verification Card -->
        <div class="verification-card mx-auto mt-4">
            <div class="card shadow-lg border-0">
                <div class="card-body p-4">

                    <!-- User Identity -->
                    <div class="user-identity text-center mb-4">
                        <div class="avatar-placeholder bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-person-fill fs-1"></i>
                        </div>

                        <h2 class="display-6 fw-bold text-primary mb-2">{{ user.displayName }}</h2>

                        <div class="badges mb-3">
                            {% if isDirector %}
                                <span class="badge bg-danger fs-6 me-2">
                                    <i class="bi bi-shield-check"></i> {{ __('STAFF') }}
                                </span>
                            {% elseif isStaff %}
                                <span class="badge bg-danger fs-6 me-2">
                                    <i class="bi bi-shield-check"></i> {{ __('STAFF') }}
                                </span>
                            {% else %}
                                <span class="badge bg-primary fs-6 me-2">
                                    <i class="bi bi-person"></i> {{ __('VOLUNTEER') }}
                                </span>
                            {% endif %}

                            {% if badgeNumber %}
                                <span class="badge bg-secondary fs-6">
                                    <i class="bi bi-person-badge"></i> {{ badgeNumber }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- User Details -->
                    <div class="user-details mb-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="info-item">
                                    <label class="text-muted small">{{ __('User ID') }}</label>
                                    <div class="fw-bold">{{ user.id }}</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="info-item">
                                    <label class="text-muted small">{{ __('Email') }}</label>
                                    <div class="fw-bold">{{ user.email }}</div>
                                </div>
                            </div>
                            {% if user.personalData.first_name or user.personalData.last_name %}
                            <div class="col-12">
                                <div class="info-item">
                                    <label class="text-muted small">{{ __('Full Name') }}</label>
                                    <div class="fw-bold">
                                        {{ user.personalData.first_name }} {{ user.personalData.last_name }}
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Current Shift Status -->
                    <div class="shift-status mb-4">
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-clock"></i> {{ __('Shift Status') }}
                        </h5>

                        {% if currentShift %}
                            <div class="current-shift alert alert-info mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">
                                            <i class="bi bi-play-circle-fill text-success"></i> {{ __('Currently On Shift') }}
                                        </h6>
                                        <div class="fw-bold">{{ currentShift.title }}</div>
                                        <small class="text-muted">
                                            {{ currentShift.location }} • {{ currentShift.type }}
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        <div class="progress mb-1" style="width: 100px; height: 8px;">
                                            <div class="progress-bar" role="progressbar" style="width: {{ currentShift.progress }}%"></div>
                                        </div>
                                        <small class="text-muted">{{ currentShift.progress }}% {{ __('complete') }}</small>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">
                                        {{ currentShift.start.format('H:i') }} - {{ currentShift.end.format('H:i') }}
                                        ({{ currentShift.start.format('d.m.Y') }})
                                    </small>
                                </div>
                            </div>
                        {% else %}
                            <div class="alert alert-light mb-3">
                                <i class="bi bi-pause-circle"></i> {{ __('Not currently on shift') }}
                            </div>
                        {% endif %}

                        {% if nextShift %}
                            <div class="next-shift">
                                <h6 class="mb-2">
                                    <i class="bi bi-calendar-plus"></i> {{ __('Next Shift') }}
                                </h6>
                                <div class="card border-0 bg-light">
                                    <div class="card-body p-3">
                                        <div class="fw-bold">{{ nextShift.title }}</div>
                                        <div class="text-muted small mb-1">
                                            {{ nextShift.location }} • {{ nextShift.type }}
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                {{ nextShift.start.format('H:i d.m.Y') }} - {{ nextShift.end.format('H:i') }}
                                            </small>
                                            <span class="badge bg-info">
                                                {{ __('in %s hours', [nextShift.starts_in_hours]) }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="text-muted">
                                <i class="bi bi-calendar-x"></i> {{ __('No upcoming shifts scheduled') }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Security Footer -->
                    <div class="security-footer text-center">
                        <hr class="my-4">
                        <div class="row g-3">
                            <div class="col-4">
                                <small class="text-muted d-block">{{ __('Verified') }}</small>
                                <i class="bi bi-shield-check text-success fs-4"></i>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">{{ __('Secure') }}</small>
                                <i class="bi bi-lock-fill text-primary fs-4"></i>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">{{ __('Official') }}</small>
                                <i class="bi bi-patch-check-fill text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4 mb-3">
            <small class="text-muted">
                {{ __('Digital ID Verification System') }} - {{ config('app_name') }}
                <br>
                {{ __('Token expires') }}: {{ token.expires_at.format('H:i:s d.m.Y') }}
            </small>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="{{ asset('assets/digitalid.js') }}"></script>
</body>
</html>
